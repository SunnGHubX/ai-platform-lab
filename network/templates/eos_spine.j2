! {{ d.name }} - generated by netgen from fabric {{ fabric.name }}. Do not edit by hand.
hostname {{ d.name }}
service routing protocols model multi-agent
!
interface Loopback0
   description router-id
   ip address {{ d.loopback }}
!
{% for n in d.neighbors %}
interface {{ n.port }}
   description to-{{ n.peer }}
   no switchport
   mtu {{ fabric.mtu }}
   ip address {{ n.local_ip }}
!
{% endfor %}
ip routing
!
router bgp {{ d.asn }}
   router-id {{ d.loopback.ip }}
   maximum-paths 64 ecmp 64
   bgp bestpath as-path multipath-relax
{% for n in d.neighbors %}
   neighbor {{ n.ip }} remote-as {{ n.asn }}
   neighbor {{ n.ip }} description {{ n.peer }}
   neighbor {{ n.ip }} send-community
{% endfor %}
   network {{ d.loopback }}
!
end
