! {{ d.name }} - generated by netgen from fabric {{ fabric.name }}. Do not edit by hand.
hostname {{ d.name }}
service routing protocols model multi-agent
!
{% if d.server_vlan %}
vlan {{ d.server_vlan.id }}
   name {{ d.server_vlan.name }}
!
{% endif %}
{% if d.rdma %}
! ---- RoCEv2 lossless profile: DSCP 26 -> TC3, PFC no-drop on priority 3, ECN on TC3 ----
qos map dscp 26 to traffic-class 3
!
{% endif %}
interface Loopback0
   description router-id
   ip address {{ d.loopback }}
!
{% for n in d.neighbors %}
interface {{ n.port }}
   description to-{{ n.peer }}
   no switchport
   mtu {{ fabric.mtu }}
   ip address {{ n.local_ip }}
{% if d.rdma %}
   qos trust dscp
   priority-flow-control on
   priority-flow-control priority 3 no-drop
   tx-queue 3
      random-detect ecn minimum-threshold 150 kbytes maximum-threshold 1500 kbytes
{% endif %}
!
{% endfor %}
{% if d.server_vlan %}
interface Vlan{{ d.server_vlan.id }}
   description {{ d.server_vlan.name }} gateway
   mtu {{ fabric.mtu }}
   ip address {{ d.server_gateway }}
!
{% endif %}
ip routing
!
router bgp {{ d.asn }}
   router-id {{ d.loopback.ip }}
   maximum-paths 4 ecmp 4
   neighbor SPINES peer group
   neighbor SPINES remote-as {{ fabric.spine_asn }}
   neighbor SPINES send-community
{% for n in d.neighbors %}
   neighbor {{ n.ip }} peer group SPINES
   neighbor {{ n.ip }} description {{ n.peer }}
{% endfor %}
   network {{ d.loopback }}
{% if d.server_vlan %}
   network {{ d.server_vlan.subnet }}
{% endif %}
!
end
