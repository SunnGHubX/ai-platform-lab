/* {{ d.name }} - generated by netgen from fabric {{ fabric.name }}. Do not edit by hand. */
set system host-name {{ d.name }}
set interfaces lo0 unit 0 family inet address {{ d.loopback }}
{% for n in d.neighbors %}
set interfaces {{ n.port }} description to-{{ n.peer }}
set interfaces {{ n.port }} mtu {{ fabric.mtu }}
set interfaces {{ n.port }} unit 0 family inet address {{ n.local_ip }}
{% endfor %}
{% if d.server_vlan %}
set vlans {{ d.server_vlan.name }} vlan-id {{ d.server_vlan.id }}
set vlans {{ d.server_vlan.name }} l3-interface irb.{{ d.server_vlan.id }}
set interfaces irb unit {{ d.server_vlan.id }} family inet address {{ d.server_gateway }}
{% endif %}
set routing-options router-id {{ d.loopback.ip }}
set routing-options autonomous-system {{ d.asn }}
set policy-options policy-statement ECMP then load-balance per-packet
set routing-options forwarding-table export ECMP
set policy-options policy-statement EXPORT-LOCAL term loopback from interface lo0.0
set policy-options policy-statement EXPORT-LOCAL term loopback then accept
{% if d.server_vlan %}
set policy-options policy-statement EXPORT-LOCAL term servers from interface irb.{{ d.server_vlan.id }}
set policy-options policy-statement EXPORT-LOCAL term servers then accept
{% endif %}
set policy-options policy-statement EXPORT-LOCAL term reject then reject
set protocols bgp group underlay type external
set protocols bgp group underlay peer-as {{ fabric.spine_asn }}
set protocols bgp group underlay export EXPORT-LOCAL
set protocols bgp group underlay multipath multiple-as
{% for n in d.neighbors %}
set protocols bgp group underlay neighbor {{ n.ip }} description {{ n.peer }}
{% endfor %}
